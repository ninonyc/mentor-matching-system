{
    admin off
    auto_https off
}

:{$PORT} {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    @api path /api /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8080
    }
    handle {
        root * /app/frontend
        header Cache-Control "no-cache"
        file_server
    }
}
